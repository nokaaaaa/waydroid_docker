# Copy to config/network.env and edit for your LAN.
HOST_LAN_IF=wlp0s20f3
WAYDROID_IF=waydroid0
ROUTER_IP=192.168.0.1
INTERCOM_IP=192.168.0.17

# Waydroid's dnsmasq lease is normally 192.168.240.2, but verify it.
WAYDROID_IP=192.168.240.112
ADB_BIND_ADDRESS=127.0.0.1
ADB_HOST_PORT=5555

# Reserve or exclude this address in the router's DHCP settings.
ENABLE_SAME_LAN_IP=yes
ANDROID_LAN_IP=192.168.0.250
LAN_PREFIX_LENGTH=24

# Report Wi-Fi transport only to apps that require it on Waydroid Ethernet.
FAKE_WIFI_PACKAGES=jp.co.aiphone.refine

# This app constructs the scoped discovery address FF02::1%wlan0.
ENABLE_ANDROID_WLAN0_COMPAT=yes
ANDROID_WIFI_COMPAT_IF=wlan0

# Comma-separated device-specific UDP broadcast ports. Empty is valid.
BROADCAST_PORTS=

# Safety default: relays are opt-in and must be packet-capture tested.
ENABLE_MDNS_REFLECTOR=yes
ENABLE_SSDP_RELAY=no
ENABLE_BROADCAST_RELAY=no
